PUBLIC_ORIGIN=https://family.example.com
BASE_PATH=/family-tree
FAMILY_PASSWORD=replace-with-a-strong-shared-password
OWNER_EMAIL=owner@example.com
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
