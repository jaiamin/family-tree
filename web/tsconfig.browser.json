{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "Bundler",
    "strict": false, "allowJs": true, "checkJs": true, "noEmit": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"], "skipLibCheck": true,
    "types": ["node"]
  },
  "include": ["src/*.js", "src/browser.d.ts", "ui/*.js"],
  "exclude": ["ui/vendor"]
}
