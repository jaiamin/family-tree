    "@types/node": "^26.6.5",
    "cf": "1.0.0-beta.21",
    "esbuild": "^0.28.2",
    "miniflare": "^4.20260730.0",
    "typescript": "^7.0.2",
    "vite": "8.3.5"
  },
  "engines": {
    "node": ">=24.22.0"
  },
  "packageManager": "pnpm@12.15.0"
